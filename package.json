{
  "name": "@subzerodev/plugins-github",
  "version": "0.1.0",
  "description": "Provider-independent GitHub repository and portfolio data plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Running-Dev/SubZeroDev.Plugins.GitHub.git"
  },
  "bugs": {
    "url": "https://github.com/The-Running-Dev/SubZeroDev.Plugins.GitHub/issues"
  },
  "homepage": "https://plugins-github.subzerodev.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "subzerodev-github": "./dist/cli.js",
    "sz-github": "./dist/cli.js",
    "plugins-github": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "plugin.yaml"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:manifest && npm run build:schemas && tsc -p tsconfig.build.json",
    "build:manifest": "tsx tools/build-manifest.ts",
    "build:schemas": "tsx tools/build-schemas.ts",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', {recursive:true, force:true,maxRetries:60,retryDelay:250}))\"",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "release:check": "npm run check && npm audit --audit-level=high && npm run package:check",
    "package:check": "tsx tools/check-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pino": "^9.0.0",
    "yaml": "^2.0.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
